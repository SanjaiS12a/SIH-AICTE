# Copy to .env. Docker Compose reads it automatically; never commit .env.
# Keep the current database credentials for an existing PostgreSQL volume.
# Changing POSTGRES_PASSWORD here does not rotate an existing database password.
DJANGO_SECRET_KEY=local-demo-change-before-sharing
POSTGRES_DB=coordination
POSTGRES_USER=coordination
POSTGRES_PASSWORD=local-demo-only
# Host-side connection; API/worker use db:5432 inside Compose.
DB_HOST=127.0.0.1
DB_PORT=5438
DEMO_PASSWORD=Demo-only-26264!
ENABLE_REVIEWED_FACTS=0
ENABLE_INCIDENT_GROUPS=0
